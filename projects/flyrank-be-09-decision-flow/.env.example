# Optional live model adapter. Leave unset to use the deterministic local mock.
# Set these in your shell or a private, ignored local .env file; never commit secrets.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DECISION_PROVIDER=mock

# Local-only Inngest Dev Server; no account is needed.
INNGEST_DEV=1
PORT=4000

APP_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/usage_metering.sqlite3
HOST=127.0.0.1
PORT=8000

# Demo-only tenant credentials. Change them before sharing a running service.
DEMO_FREE_KEY=local-free-demo-key
DEMO_PRO_KEY=local-pro-demo-key

# Default is an offline mock. No Stripe account or payment is needed.
PAYMENT_MODE=mock
MOCK_WEBHOOK_SECRET=local-mock-only-secret-change-me

# Optional Stripe test-mode settings. Leave unset in mock mode.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

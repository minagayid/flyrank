# Local-only demo settings. Replace demo tokens and IP salt before exposing the service.
API_HOST=127.0.0.1
API_PORT=8000
DEMO_HOST=127.0.0.1
DEMO_PORT=4173
PUBLIC_BASE_URL=http://127.0.0.1:8000
DB_PATH=data/lead-capture.sqlite3
WIDGET_BUNDLE_VERSION=v1
MAX_REQUEST_BYTES=16384
RATE_BUCKET_CAPACITY=3
RATE_REFILL_PER_SECOND=2
IP_ADMISSION_BUCKET_CAPACITY=20
IP_ADMISSION_REFILL_PER_SECOND=10
GEO_MODE=mock
MOCK_GEO_A_DOWN=false
MOCK_GEO_B_DOWN=false
MOCK_NOTIFICATION_FAIL=false
ALLOW_DEV_CONTROLS=false
NOTIFICATION_MAX_ATTEMPTS=3
DEMO_TENANT_A_TOKEN=local-demo-tenant-a-only-change-before-hosting-123
DEMO_TENANT_B_TOKEN=local-demo-tenant-b-only-change-before-hosting-456
IP_HASH_SALT=local-demo-only-change-before-hosting
